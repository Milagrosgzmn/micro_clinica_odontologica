<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <!-- === APPENDERS === -->
    <Appenders>

        <!-- Consola -->
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%-5p] [%c{1}:%L] %m%n"/>
        </Console>

        <!-- Archivo con rotación -->
        <RollingFile name="file"
                     fileName="sucesos.log"
                     filePattern="sucesos-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss}] [%-5p] [%c{1}:%L] %m%n"/>
            <Policies>
                <!-- Rota el archivo cuando supera 5 MB -->
                <SizeBasedTriggeringPolicy size="5MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

    </Appenders>

    <!-- === LOGGERS === -->
    <Loggers>

        <!-- Logger raíz -->
        <Root level="info">
            <AppenderRef ref="stdout"/>
            <AppenderRef ref="file"/>
        </Root>
        <Logger name="com.clinicaOdontologica.up_microservicios" level="debug" additivity="false">
            <AppenderRef ref="stdout"/>
            <AppenderRef ref="file"/>
        </Logger>


    </Loggers>

</Configuration>
